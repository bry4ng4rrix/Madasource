# Modèle de configuration locale. Copier en .env (jamais versionné) puis remplacer
# les valeurs factices. Aucune valeur réelle ne doit figurer dans ce fichier.

# Environnement d'exécution, obligatoire : local, test, staging, production, demo (D-11).
# En staging, production et demo : pas d'origine CORS *, pas de mot de passe d'exemple,
# mot de passe de la base d'au moins 12 caractères (Q-102).
APP_ENV=local
# Niveau des journaux : DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Origines du frontend autorisées par CORS, séparées par des virgules (vide : aucune).
# Exemple factice : http://localhost:3000. Jamais * en production ; HTTPS exigé en production.
CORS_ALLOWED_ORIGINS=

# PostgreSQL de Docker Compose. Valeurs factices, à remplacer.
# Utilisateur et mot de passe : lettres et chiffres seulement, car ils sont repris tels quels
# dans une URL.
# POSTGRES_USER est le propriétaire du schéma : il sert seulement aux migrations.
POSTGRES_DB=madasource
POSTGRES_USER=madasource
POSTGRES_PASSWORD=changeme0local0only
# Mot de passe du rôle applicatif madasource_app (sans droit sur le schéma).
POSTGRES_APP_PASSWORD=changeme0app0only

# Ports de l'hôte (5432, 6379 et 8000 sont souvent déjà occupés sur le poste).
MADASOURCE_DB_HOST_PORT=5433
MADASOURCE_API_HOST_PORT=8001

# URL de l'application lancée depuis l'hôte : rôle applicatif madasource_app. Elle reprend
# POSTGRES_APP_PASSWORD, MADASOURCE_DB_HOST_PORT et POSTGRES_DB : à modifier avec eux.
# Dans Docker Compose, le service backend reçoit sa propre URL vers le service db.
DATABASE_URL=postgresql+asyncpg://madasource_app:changeme0app0only@localhost:5433/madasource
# URL des migrations (Alembic) : propriétaire du schéma. Elle reprend POSTGRES_USER,
# POSTGRES_PASSWORD, MADASOURCE_DB_HOST_PORT et POSTGRES_DB.
MIGRATION_DATABASE_URL=postgresql+asyncpg://madasource:changeme0local0only@localhost:5433/madasource

# Réglages facultatifs de la base (valeurs par défaut entre parenthèses) :
# DATABASE_POOL_SIZE (5), DATABASE_MAX_OVERFLOW (5), DATABASE_CONNECT_TIMEOUT_SECONDS (5),
# DATABASE_STATEMENT_TIMEOUT_MS (30000), READINESS_TIMEOUT_SECONDS (3).

# Mode démonstration : true seulement avec APP_ENV=demo (D-18).
DEMO_MODE=false

# Base de test éphémère (service db-test, profil « test »). Le nom de la base doit se
# terminer par _test : la configuration de test refuse toute autre base.
POSTGRES_TEST_PASSWORD=changeme0test0only
POSTGRES_TEST_APP_PASSWORD=changeme0testapp0only
MADASOURCE_TEST_DB_HOST_PORT=5434
# Tests : l'application utilise le rôle applicatif ; le schéma est créé par les
# migrations, avec le propriétaire (madasource_test).
TEST_DATABASE_URL=postgresql+asyncpg://madasource_app:changeme0testapp0only@localhost:5434/madasource_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://madasource_test:changeme0test0only@localhost:5434/madasource_test
