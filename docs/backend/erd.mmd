        numeric buyer_unit_price
    }
    quotation_version_costs {
        uuid quotation_version_id PK, FK "-> quotation_versions"
        uuid external_cost_id PK, FK "-> external_costs"
        numeric applied_amount
    }
    exchange_rates {
        uuid id PK
        char base_currency
        char quote_currency
        numeric rate
        timestamptz valid_from
    }
    category_definitions |o--o{ pricing_rule_versions : "portée"
    organizations |o--o{ pricing_rule_versions : "portée"
    rfqs ||--o{ quotations : "reçoit"
    rfq_recipients ||--o| quotations : "répond"
    quotations ||--|{ quotation_versions : "versionnée"
    pricing_rule_versions |o--o{ quotation_versions : "appliquée"
    quotation_versions ||--o| quotation_version_financials : "finances"
    quotation_versions ||--|{ quotation_lines : "lignes"
    rfq_items ||--o{ quotation_lines : "couverte par"
    products |o--o{ quotation_lines : "produit"
    quotation_versions ||--o{ quotation_version_costs : "coûts"
    external_costs ||--o{ quotation_version_costs : "appliqué"

    %% module: negotiations (13)
    negotiations {
        uuid id PK
        uuid quotation_id UK, FK "-> quotations"
        varchar status
    }
    negotiation_offers {
        uuid id PK
        uuid negotiation_id FK "-> negotiations"
        int sequence_no
        varchar author_side
        uuid based_on_quotation_version_id FK "-> quotation_versions"
