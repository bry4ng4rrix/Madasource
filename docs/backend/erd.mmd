%% ERD MadaSource : backend V1 (Jour 3, 2026-10-13).
%% Statut : proposition, non approuvée. Source détaillée : data-model.md.
%% La section trades est PROVISOIRE : elle attend la validation de Q-82.
%%
%% Lecture :
%% - Seules les colonnes structurantes sont montrées : clés, références, statuts, montants.
%% - Le commentaire d'une colonne FK donne la table cible ("-> table").
%% - Les colonnes d'acteur (created_by_user_id, decided_by_user_id...) sont omises ;
%%   elles sont toutes des FK vers users (voir data-model.md).
%% - Les références polymorphes (context_type/context_id, object_type/object_id)
%%   n'ont pas de clé étrangère et n'apparaissent pas comme relations.
%% - Chaque bloc commence par "%% module: <nom> (<niveau>)". Une FK ne pointe jamais
%%   vers un module de niveau supérieur (D-07).
%% - Tables conditionnelles : outbox_messages (D-20), exchange_rates (Q-65),
%%   sample_requests (Q-53), favorites (Q-63).

erDiagram

    %% module: socle (0)
    outbox_messages {
        uuid id PK
        varchar channel
        varchar template_code
        bytea recipient_encrypted "PERSONNEL"
        bytea payload_encrypted "SECRET"
        varchar status
    }

    %% module: audit (1)
    audit_logs {
        uuid id PK
        timestamptz occurred_at
        varchar category
        varchar actor_kind
        uuid actor_user_id "sans FK"
        uuid acting_organization_id "sans FK"
        uuid on_behalf_of_organization_id "sans FK"
        varchar action
        varchar object_type
        uuid object_id
        varchar result
        varchar restricted_sets "tableau : FINANCE, BANK"
    }

    %% module: auth (2)
    users {
        uuid id PK
        varchar email UK "PERSONNEL"
        text password_hash "SECRET"
        varchar status
        timestamptz email_verified_at
        timestamptz anonymized_at
    }
    sessions {
        uuid id PK
        uuid user_id FK "-> users"
        timestamptz expires_at
        timestamptz revoked_at
    }
    refresh_tokens {
        uuid id PK
        uuid session_id FK "-> sessions"
        char token_hash UK "SECRET"
        uuid replaced_by_id FK "-> refresh_tokens"
        timestamptz consumed_at
    }
    email_verification_tokens {
        uuid id PK
        uuid user_id FK "-> users"
        char token_hash UK "SECRET"
        timestamptz used_at
    }
    password_reset_tokens {
        uuid id PK
        uuid user_id FK "-> users"
        char token_hash UK "SECRET"
        timestamptz used_at
    }
    users ||--o{ sessions : "ouvre"
    sessions ||--o{ refresh_tokens : "émet"
    refresh_tokens |o--o| refresh_tokens : "remplacé par"
    users ||--o{ email_verification_tokens : "reçoit"
    users ||--o{ password_reset_tokens : "reçoit"

    %% module: organizations (3)
    organizations {
        uuid id PK
        varchar legal_name
        char country_code
    }
    organization_capabilities {
        uuid id PK
        uuid organization_id FK "-> organizations"
        varchar capability "BUYER ou EXPORTER"
        varchar account_status
    }
    organization_memberships {
        uuid id PK
        uuid organization_id FK "-> organizations"
        uuid user_id FK "-> users"
        varchar role "OWNER ou MEMBER"
        varchar status
    }
    organization_invitations {
        uuid id PK
        uuid organization_id FK "-> organizations"
        varchar email "PERSONNEL"
        char token_hash UK "SECRET"
        varchar status
        timestamptz expires_at
    }
    organizations ||--|{ organization_capabilities : "possède"
    organizations ||--|{ organization_memberships : "compte"
    users ||--o{ organization_memberships : "adhère"
    organizations ||--o{ organization_invitations : "invite"

    %% module: access_control (4)
    roles {
        uuid id PK
        varchar code UK
        varchar scope
    }
    permissions {
        uuid id PK
        varchar code UK
        varchar scope
        varchar required_capability
        varchar permission_set
    }
    role_permissions {
        uuid role_id PK, FK "-> roles"
        uuid permission_id PK, FK "-> permissions"
        varchar scope "composite avec role_id et permission_id"
    }
    platform_role_assignments {
        uuid id PK
        uuid user_id FK "-> users"
        uuid role_id FK "-> roles"
        timestamptz revoked_at
    }
    roles ||--o{ role_permissions : "accorde"
    permissions ||--o{ role_permissions : "incluse dans"
    users ||--o{ platform_role_assignments : "détient"
    roles ||--o{ platform_role_assignments : "attribué"

    %% module: notifications (5)
    notifications {
        uuid id PK
        uuid recipient_user_id FK "-> users"
        uuid organization_id FK "-> organizations"
        varchar type_code
        varchar object_type
        uuid object_id
        timestamptz read_at
    }
    users ||--o{ notifications : "reçoit"
    organizations |o--o{ notifications : "contexte"

    %% module: documents (6)
    documents {
        uuid id PK
        varchar owner_kind
        uuid owner_organization_id FK "-> organizations"
        varchar category
        varchar context_type
        uuid context_id
        uuid related_trade_id "sans FK"
        varchar status
    }
    document_versions {
        uuid id PK
        uuid document_id FK "-> documents"
        varchar document_category FK "-> documents (composite avec document_id)"
        int version_no
        varchar storage_key UK "SECRET"
        char sha256
        varchar visibility
        varchar scan_status
    }
    organizations |o--o{ documents : "dépose"
    documents ||--|{ document_versions : "versionné"

    %% module: messages (7)
    conversations {
        uuid id PK
        varchar context_type
        uuid context_id
        varchar channel "BUYER_MADASOURCE, EXPORTER_MADASOURCE, DIRECT"
    }
    conversation_participants {
        uuid id PK
        uuid conversation_id FK "-> conversations"
        uuid organization_id FK "-> organizations"
        varchar side
        timestamptz left_at
    }
    messages {
        uuid id PK
        uuid conversation_id FK "-> conversations"
        uuid author_user_id FK "-> users"
        uuid author_organization_id FK "-> organizations"
        text body
    }
    message_attachments {
        uuid message_id PK, FK "-> messages"
        uuid document_id PK, FK "-> documents"
    }
    conversations ||--|{ conversation_participants : "réunit"
    organizations |o--o{ conversation_participants : "participe"
    conversations ||--o{ messages : "contient"
    users ||--o{ messages : "écrit"
    organizations |o--o{ messages : "signe"
    messages ||--o{ message_attachments : "joint"
    documents ||--o{ message_attachments : "joint à"

    %% module: buyers (8)
    buyer_profiles {
        uuid organization_id PK, FK "-> organizations"
        varchar business_type
        varchar contact_email "PERSONNEL"
    }
    organizations ||--o| buyer_profiles : "profil acheteur"

    %% module: verification (8)
    verification_records {
        uuid id PK
        uuid organization_id FK "-> organizations"
        smallint level
        varchar status
        timestamptz expires_at
        text internal_notes "INTERNAL_ONLY"
        uuid supersedes_record_id FK "-> verification_records"
    }
    verification_reviewed_documents {
        uuid verification_record_id PK, FK "-> verification_records"
        uuid document_id PK, FK "-> documents"
    }
    organizations ||--o{ verification_records : "vérifiée par"
    verification_records |o--o| verification_records : "remplace"
    verification_records ||--o{ verification_reviewed_documents : "examine"
    documents ||--o{ verification_reviewed_documents : "examiné"

    %% module: exporters (9)
    exporter_public_slugs {
        varchar slug PK
        uuid organization_id FK "-> organizations"
        timestamptz retired_at
    }
    exporter_profiles {
        uuid organization_id PK, FK "-> organizations"
        varchar public_slug UK, FK "-> exporter_public_slugs"
        uuid logo_document_id FK "-> documents (composite avec organization_id)"
        bytea tax_identifier_encrypted "SENSIBLE"
    }
    capacity_records {
        uuid id PK
        uuid organization_id FK "-> exporter_profiles"
        varchar category_code "code, sans FK"
        numeric quantity
        varchar unit
    }
    exporter_certifications {
        uuid id PK
        uuid organization_id FK "-> exporter_profiles"
        varchar certification_code
        uuid proof_document_id FK "-> documents"
        date valid_until
    }
    bank_details {
        uuid id PK
        uuid organization_id FK "-> exporter_profiles"
        bytea account_number_encrypted "BANCAIRE"
        varchar masked_display
        char currency
        varchar status
        timestamptz effective_from
    }
    organizations ||--o| exporter_profiles : "profil exportateur"
    organizations ||--o{ exporter_public_slugs : "réserve"
    exporter_public_slugs ||--o| exporter_profiles : "slug courant"
    documents |o--o{ exporter_profiles : "logo"
    exporter_profiles ||--o{ capacity_records : "déclare"
    exporter_profiles ||--o{ exporter_certifications : "détient"
    documents |o--o{ exporter_certifications : "preuve"
    exporter_profiles ||--o{ bank_details : "coordonnées"

    %% module: products (10)
    category_definitions {
        varchar code PK "VANILLA, CLOVES, COCOA"
        jsonb labels
    }
    category_attributes {
        uuid id PK
        varchar category_code FK "-> category_definitions"
        varchar code
        varchar data_type
        varchar status
    }
    products {
        uuid id PK
        uuid organization_id FK "-> organizations"
        varchar category_code FK "-> category_definitions"
        varchar name
        numeric price_indication_amount
        varchar status
    }
    product_attribute_values {
        uuid product_id PK, FK "-> products (composite avec category_code)"
        uuid attribute_id PK, FK "-> category_attributes (composite avec category_code)"
        varchar category_code
    }
    category_definitions ||--o{ category_attributes : "définit"
    category_definitions ||--o{ products : "classe"
    organizations ||--o{ products : "publie"
    products ||--o{ product_attribute_values : "caractérisé"
    category_attributes ||--o{ product_attribute_values : "valeur"

    %% module: rfqs (11)
    rfqs {
        uuid id PK
        varchar reference UK "RFQ-AAAA-XXXXXX"
        uuid buyer_organization_id FK "-> organizations"
        varchar status
        varchar distribution_mode
        char destination_country_code
        numeric target_price_amount
    }
    rfq_items {
        uuid id PK
        uuid rfq_id FK "-> rfqs"
        smallint line_no
        varchar category_code FK "-> category_definitions"
        uuid product_id FK "-> products"
        numeric quantity
        varchar unit
        varchar status "Q-95"
    }
    rfq_recipients {
        uuid id PK
        uuid rfq_id FK "-> rfqs (composite avec buyer_organization_id)"
        uuid buyer_organization_id
        uuid exporter_organization_id FK "-> organizations"
        varchar source
        varchar status
    }
    rfq_questions {
        uuid id PK
        uuid rfq_id FK "-> rfqs"
        uuid recipient_id FK "-> rfq_recipients"
        text question
        varchar visibility
    }
    organizations ||--o{ rfqs : "demande"
    rfqs ||--|{ rfq_items : "ligne"
    category_definitions ||--o{ rfq_items : "catégorie"
    products |o--o{ rfq_items : "produit visé"
    rfqs ||--o{ rfq_recipients : "diffusée à"
    organizations ||--o{ rfq_recipients : "destinataire"
    rfqs ||--o{ rfq_questions : "questions"
    rfq_recipients ||--o{ rfq_questions : "paire"

    %% module: quotations (12)
    pricing_rule_versions {
        uuid id PK
        int version_no UK
        varchar commercial_model
        varchar method
        numeric value
        varchar category_code FK "-> category_definitions"
        uuid exporter_organization_id FK "-> organizations"
        varchar status
    }
    external_costs {
        uuid id PK
        varchar cost_type
        numeric amount
        char currency
        timestamptz valid_until
    }
    quotations {
        uuid id PK
        varchar reference UK "MSQ-AAAA-XXXXXX"
        uuid rfq_id FK "-> rfqs (composite avec buyer_organization_id)"
        uuid recipient_id FK "-> rfq_recipients (composite avec rfq_id, exporter_organization_id)"
        uuid buyer_organization_id
        uuid exporter_organization_id
        varchar status
        int current_version_no
    }
    quotation_versions {
        uuid id PK
        uuid quotation_id FK "-> quotations"
        int version_no
        timestamptz expires_at
        varchar commercial_model
        uuid pricing_rule_version_id FK "-> pricing_rule_versions"
        char currency
        numeric supplier_total_amount "PRIX NET"
        numeric buyer_total_amount
    }
    quotation_version_financials {
        uuid quotation_version_id PK, FK "-> quotation_versions"
        numeric margin_total "FINANCE"
        numeric commission_amount "FINANCE"
    }
    quotation_lines {
        uuid id PK
        uuid quotation_version_id FK "-> quotation_versions"
        uuid rfq_item_id FK "-> rfq_items"
