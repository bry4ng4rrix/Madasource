    quotation_versions ||--o{ negotiation_offers : "base"
    negotiation_offers ||--o{ negotiation_offer_lines : "lignes"
    quotation_lines ||--o{ negotiation_offer_lines : "ligne"
    negotiation_offers ||--o| negotiation_offer_financials : "finances"
    negotiation_offers ||--o{ offer_external_costs : "coûts"
    external_costs ||--o{ offer_external_costs : "appliqué"

    %% module: trades (14) PROVISOIRE (Q-82)
    trades {
        uuid id PK
        varchar reference UK "MST-AAAA-XXXXXX"
        uuid rfq_id "composite vers quotations"
        uuid quotation_id UK, FK "-> quotations (composite avec rfq, buyer et exporter)"
        uuid buyer_organization_id
        uuid exporter_organization_id
        uuid accepted_quotation_version_id FK "-> quotation_versions (composite avec quotation_id)"
        uuid accepted_offer_id FK "-> negotiation_offers"
        varchar commercial_model
        varchar status
        varchar shipment_summary
    }
    trade_items {
        uuid id PK
        uuid trade_id FK "-> trades"
        uuid rfq_item_id "composite vers quotation_lines ; unique partiel"
        uuid quotation_line_id FK "-> quotation_lines (composite avec rfq_item_id)"
        numeric quantity
        varchar unit
        timestamptz released_at
    }
    trade_agreements {
        uuid id PK
        uuid trade_id FK "-> trades"
        varchar commercial_model "composite vers trades"
        varchar kind "SALE, SUPPLY ou DIRECT"
        char currency
        numeric total_amount
        timestamptz frozen_at
        varchar payment_status
    }
    trade_agreement_lines {
        uuid agreement_id PK, FK "-> trade_agreements (composite avec trade_id)"
        uuid trade_item_id PK, FK "-> trade_items (composite avec trade_id)"
        uuid trade_id
        numeric unit_price
        numeric line_total
    }
    trade_financials {
        uuid trade_id PK, FK "-> trades"
        numeric margin_total "FINANCE"
        numeric commission_amount "FINANCE"
        timestamptz frozen_at
    }
    trade_events {
        uuid id PK
        uuid trade_id FK "-> trades"
        timestamptz occurred_at
        varchar actor_kind
        varchar event_type
        varchar visibility
        uuid agreement_id FK "-> trade_agreements (composite avec trade_id, agreement_kind)"
        varchar agreement_kind
        uuid document_id FK "-> documents"
    }
    quotations ||--o| trades : "acceptée en"
    quotation_versions ||--o{ trades : "version acceptée"
    negotiation_offers |o--o| trades : "offre acceptée"
    trades ||--|{ trade_items : "lignes"
    quotation_lines ||--o{ trade_items : "origine"
    trades ||--|{ trade_agreements : "conventions"
    trade_agreements ||--|{ trade_agreement_lines : "prix"
    trade_items ||--|{ trade_agreement_lines : "valorisée"
    trades ||--o| trade_financials : "finances"
    trades ||--|{ trade_events : "historique"
    trade_agreements |o--o{ trade_events : "relation"
    documents |o--o{ trade_events : "pièce"

